# Server configuration
PORT=5000
NODE_ENV=development

# Cloud MySQL Database Configuration (Aiven MySQL / Remote Cloud MySQL ONLY)
# Localhost, 127.0.0.1, and local MySQL port 3306 are blocked.
DB_HOST=your-aiven-host.aivencloud.com
DB_PORT=your-aiven-port
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# SSL Configuration (Required for Aiven MySQL / Managed Cloud MySQL)
DB_SSL=true
DB_SSL_CA=./ca.pem
DB_SSL_REJECT_UNAUTHORIZED=true

# Alternative: Single Cloud Connection URL Format
# DATABASE_URL=mysql://user:password@your-aiven-host.aivencloud.com:27011/lokah_builders

# JWT Secrets & Security
JWT_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
COOKIE_SECRET=your_cookie_secret_signature_here
# Frontend origin for CORS (e.g. https://lokah-frontend-coral.vercel.app or comma-separated)
FRONTEND_URL=https://lokah-frontend-coral.vercel.app
# Cookie SameSite: 'none' for cross-site (Vercel -> Render), 'lax' for local dev or same-domain
COOKIE_SAMESITE=none

# Initial Cloud Super Admin Seed Settings
ADMIN_EMAIL=admin@lokahbuilders.com
ADMIN_NAME=Administrator
ADMIN_PASSWORD=your_secure_admin_password

# SMTP settings for password-reset emails (optional)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
