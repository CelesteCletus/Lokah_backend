# ==============================================================================
# Lokah Builders Backend - Environment Configuration Template
# ==============================================================================
# This template is compatible with cPanel Node.js Selector (Phusion Passenger)
# and standard Node.js hosting environments.
#
# IMPORTANT:
# 1. Copy this file to .env in your application root folder on the server.
# 2. In production, the application will refuse to start if any of the 5 core
#    variables (JWT_SECRET, JWT_REFRESH_SECRET, COOKIE_SECRET, FRONTEND_URL,
#    ADMIN_PASSWORD) are missing.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT & PORT
# ------------------------------------------------------------------------------
# Set to 'production' for live deployments.
NODE_ENV=production

# On cPanel (CloudLinux/Passenger), the PORT is automatically assigned by the
# web server reverse proxy. A fallback port is provided for standalone testing.
PORT=5000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (cPanel MySQL / Local or Remote)
# ------------------------------------------------------------------------------
# Option A: cPanel Local MySQL (Standard for cPanel hosting)
# In cPanel, database names and usernames are prefixed with your cPanel account username.
# Example: cpuser_lokahdb, cpuser_lokahadmin
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_cpanel_database_name
DB_USER=your_cpanel_database_user
DB_PASSWORD=your_cpanel_database_user_password

# SSL Configuration for Database:
# - For cPanel local MySQL (on the same host): MUST be set to false.
# - For remote cloud databases (e.g. Aiven): set to true and supply ca.pem.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false
DB_SSL_CA=

# Optional single-URL database connection format (alternative to individual variables above)
# DATABASE_URL=mysql://user:password@localhost:3306/your_database_name

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION SECRETS (Can reuse existing Airo values)
# ------------------------------------------------------------------------------
# In production, these 3 secrets must be set to long, unique random strings.
# You can copy the exact existing secrets from your GoDaddy Airo environment variables screen.
JWT_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
COOKIE_SECRET=your_cookie_signing_secret_here

# Token Lifespans (Optional overrides, defaults: 1d and 30d)
JWT_ACCESS_EXPIRY=1d
JWT_REFRESH_EXPIRY=30d

# ------------------------------------------------------------------------------
# 4. CORS & COOKIE POLICIES
# ------------------------------------------------------------------------------
# CORS_ORIGIN: Allowed frontend origin for CORS. Can be a single origin or comma-separated list.
# IMPORTANT: Set to the exact frontend origin (no trailing slash, no "*").
CORS_ORIGIN=https://xzw5gqcr6f.c35.airoapp.ai

# FRONTEND_URL: Comma-separated list of additional allowed frontend origins.
# (e.g. your custom domain, preview, or Vercel URLs).
FRONTEND_URL=https://lokahbuilders.com,https://www.lokahbuilders.com

# COOKIE_SAMESITE:
# - 'none' for cross-site environments (e.g. frontend on xzw5gqcr6f.c35.airoapp.ai
#   and backend on 6qxwqtx3i8.c40.airoapp.ai). Requires HTTPS (Secure=true).
# - 'lax' for same-site / same-domain environments or local testing.
COOKIE_SAMESITE=none

# ------------------------------------------------------------------------------
# 5. INITIAL SUPERADMIN SEEDING
# ------------------------------------------------------------------------------
# On first boot against a new/empty database, the backend automatically creates
# this initial superadmin account in the MySQL admins table.
ADMIN_EMAIL=admin@lokahbuilders.com
ADMIN_NAME=Administrator
ADMIN_PASSWORD=your_secure_admin_password

# ------------------------------------------------------------------------------
# 6. SMTP EMAIL CONFIGURATION (cPanel Mail or External SMTP)
# ------------------------------------------------------------------------------
# Required for admin password-reset emails.
# You can use a cPanel email account (cPanel -> Email Accounts) or an external SMTP service.
# For cPanel SSL mail: Host is mail.yourdomain.com, Port 465 (SSL) or 587 (TLS).
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=465
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=your_cpanel_email_account_password
SMTP_FROM="Lokah Builders" <noreply@yourdomain.com>
